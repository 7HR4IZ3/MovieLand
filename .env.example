# Client-side Convex deployment URL. This is public by design.
VITE_CONVEX_URL=

# Optional server-only Convex URL used by web SSR. Set this in Vercel, too.
CONVEX_URL=

# Native AdMob ad units. Leave unset while using Google's test units on iOS or
# set VITE_ADMOB_TEST_MODE=true for a local native test build.
VITE_ADMOB_TEST_MODE=false
VITE_ADMOB_BANNER_ID=
VITE_ADMOB_APP_OPEN_ID=
VITE_ADMOB_INTERSTITIAL_ID=

# Set these in the Convex dashboard or with `bunx convex env set`.
# TMDB_READ_ACCESS_TOKEN=
# TMDB_API_KEY=
